{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ffqa/xissue/schemas/plugin.schema.json",
  "title": "xIssue plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "name",
    "version",
    "entrypoint",
    "events"
  ],
  "properties": {
    "apiVersion": {
      "const": 1,
      "description": "Manifest contract version. xIssue rejects unknown versions."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Stable plugin id. Used as the install directory name."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Plugin release version."
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.).+$",
      "description": "Relative executable path inside the plugin directory."
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "branch_push",
          "pr_merged",
          "pr_created",
          "pr_comment",
          "pr_review",
          "notification_dispatch",
          "issue_created",
          "issue_status_changed",
          "run_started",
          "run_finished",
          "all",
          "*"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "repo:read",
          "repo:write",
          "network",
          "notify",
          "process"
        ]
      },
      "description": "Informational declarations shown in the UI. Not an OS sandbox."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "description": "Optional sandboxed web UI served from <plugin>/ui.",
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^ui/(?!.*\\.\\.).+$",
          "description": "HTML entry under ui/."
        },
        "title": {
          "type": "string",
          "description": "Display title; defaults to the plugin name."
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "project.page",
              "project.header",
              "project.toolbar",
              "issue.page",
              "issue.actions",
              "issue.toolbar"
            ]
          },
          "description": "Host slots that mount the UI. Empty means full page only."
        }
      }
    }
  }
}
